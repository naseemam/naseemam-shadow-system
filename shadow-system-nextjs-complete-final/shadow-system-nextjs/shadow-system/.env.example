# =============================================================
# Ameer System — Environment Variables Template
# Copy this file to .dev.vars for local Cloudflare dev (wrangler)
# =============================================================

# JWT secret — use a strong random string (minimum 32 chars)
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-secure-random-secret-at-least-32-chars

# Node.js environment
NODE_ENV=development
